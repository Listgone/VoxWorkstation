{
  "name": "vox-workstation",
  "version": "1.0.1",
  "description": "VoxCPM2 AI Voice Workstation",
  "author": "VoxWorkstation",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.voxcpm.workstation",
    "productName": "VoxWorkstation",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "vox.config.json",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VoxWorkstation"
    }
  },
  "devDependencies": {
    "electron": "^31.7.5",
    "electron-builder": "^25.0.0"
  }
}
